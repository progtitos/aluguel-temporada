# ===== Supabase =====
# Painel Supabase > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key-publica
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key-SECRETA

# ===== Admin =====
# E-mails (separados por vírgula) autorizados a acessar o /admin.
# Devem ser os MESMOS e-mails cadastrados em Authentication > Users no Supabase.
ADMIN_EMAILS=seuemail@gmail.com

# ===== Mercado Pago =====
# Painel Mercado Pago > Suas integrações > Credenciais de produção
MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===== App =====
# URL pública do seu site (usada no webhook e nos back_urls do checkout).
# Precisa ser HTTPS válida — em localhost, deixe como está: o app detecta
# e simplesmente omite notification_url/back_urls automaticamente.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.vercel.app

# ===== E-mail de confirmação (Resend) =====
# Painel resend.com > API Keys. Sem essa chave, o app simplesmente não
# envia o e-mail (não quebra a confirmação da reserva).
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Opcional: remetente com seu domínio verificado no Resend.
# Sem isso, usa o remetente de teste "onboarding@resend.dev".
EMAIL_FROM="Sua Pousada <reservas@seudominio.com>"
